    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "broker": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "funding_domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "client_id",
        "broker",
        "account",
        "currency",
        "funding_domain"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_reference_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "as_of": {
          "type": "string",
          "minLength": 1
        },
        "available_at": {
          "type": "string",
          "minLength": 1
        },
        "qualification": {
          "const": "VERIFIED_AT_CUTOFF"
        },
        "complete": {
          "type": "boolean"
        },
        "empty_portfolio_asserted": {
          "type": "boolean"
        },
        "confirmed_effects_already_applied": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "source_reference_id",
        "source_sha256",
        "as_of",
        "available_at",
        "qualification"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_reference_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "as_of": {
          "type": "string",
          "minLength": 1
        },
        "available_at": {
          "type": "string",
          "minLength": 1
        },
        "qualification": {
          "const": "VERIFIED_AT_CUTOFF"
        },
        "complete": {
          "type": "boolean"
        },
        "empty_portfolio_asserted": {
          "type": "boolean"
        },
        "confirmed_effects_already_applied": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "source_reference_id",
        "source_sha256",
        "as_of",
        "available_at",
        "qualification",
        "complete",
        "empty_portfolio_asserted",
        "confirmed_effects_already_applied"
      ]
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_id": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "source_reference_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "base_id",
        "amount",
        "currency",
        "source_reference_id"
      ]
    },
    "ceiling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "cap_scope": {
          "const": "TOTAL_PORTFOLIO_STOCK"
        },
        "accounting_base": {
          "$ref": "#/$defs/base"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      },
      "required": [
        "amount",
        "currency",
        "cap_scope",
        "accounting_base",
        "receipt"
      ]
    },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cap_id": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "enum": [
            "REQUIRED",
            "NOT_APPLICABLE"
          ]
        },
        "value_state": {
          "enum": [
            "KNOWN",
            "UNKNOWN",
            "NONE"
          ]
        },
        "amount": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "accounting_base": {
          "$ref": "#/$defs/base"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      },
      "required": [
        "cap_id",
        "applicability",
        "value_state"
      ]
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "economic_effect_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "CONFIRMED_POSITION",
            "ACTIVE_BUY_RESERVATION",
            "OTHER_COMMITMENT",
            "RELEASE"
          ]
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "intent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "side": {
          "enum": [
            "BUY",
            "SELL",
            null
          ]
        },
        "amount_basis": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_state": {
          "type": "string",
          "minLength": 1
        },
        "release_confirmed": {
          "type": "boolean"
        },
        "releases_event_id": {
          "type": "string",
          "minLength": 1
        },
        "release_state": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      },
      "required": [
        "event_id",
        "economic_effect_ids",
        "kind",
        "owner",
        "asset_id",
        "amount",
        "currency",
        "receipt"
      ]
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket_id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "value_state": {
          "enum": [
            "KNOWN",
            "UNKNOWN"
          ]
        },
        "settled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cash_amount": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "reserved_amount": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "cash_basis": {
          "enum": [
            "NET_AVAILABLE",
            "GROSS_SETTLED_CASH"
          ]
        },
        "authorized_incremental_amount": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      },
      "required": [
        "bucket_id",
        "owner",
        "currency",
        "value_state",
        "settled",
        "cash_amount",
        "reserved_amount",
        "cash_basis",
        "authorized_incremental_amount",
        "receipt"
      ]
    },
    "fx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "from_currency": {
          "type": "string",
          "minLength": 1
        },
        "to_currency": {
          "type": "string",
          "minLength": 1
        },
        "quote_per_base": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "accounting_base_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "const": "REPORTING_BUDGET_NORMALIZATION_NOT_EXECUTION"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      },
      "required": [
        "owner",
        "from_currency",
        "to_currency",
        "quote_per_base",
        "accounting_base_id",
        "purpose",
        "receipt"
      ]
    }
  }
}
