{
  "$defs": {
    "CanonicalUnit": {
      "enum": [
        "PERCENT",
        "PERCENTAGE_POINT",
        "BASIS_POINT"
      ],
      "title": "CanonicalUnit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "unit": {
      "$ref": "#/$defs/CanonicalUnit",
      "default": "PERCENT"
    },
    "value": {
      "anyOf": [
        {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "value"
  ],
  "title": "PercentValue",
  "type": "object"
}
