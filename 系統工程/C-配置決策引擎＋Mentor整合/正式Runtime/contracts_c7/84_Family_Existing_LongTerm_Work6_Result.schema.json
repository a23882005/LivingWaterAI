  "$defs": {
    "MoneyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_state",
        "amount",
        "currency",
        "as_of",
        "data_quality",
        "freshness",
        "issue_codes",
        "source_reference_ids"
