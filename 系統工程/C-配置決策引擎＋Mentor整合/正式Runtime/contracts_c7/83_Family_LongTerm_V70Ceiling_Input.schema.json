{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "C.FamilyLongTermV70CeilingInput.v1"
    },
    "profile": {
      "const": "FAMILY_LONG_TERM_TARGET_WITH_V70_CEILING_V1"
    },
    "approval_contract_sha256": {
      "const": "112b4ffad8d900971879f5502702bbf1252214edd709d22398a604ec070ed2e0"
    },
    "identity": {
      "type": "object",
      "required": [
        "client_id",
        "run_id",
        "portfolio_id"
      ]
    },
    "family_owner": {
      "$ref": "#/$defs/owner"
    },
    "budget_currency": {
      "type": "string",
      "minLength": 1
    },
    "account_owners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/owner"
      },
      "minItems": 1
    },
    "source_db_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_version": {
      "type": [
        "string",
        "integer"
      ]
    },
    "approved_long_term_target": {
      "type": "object"
    },
    "approved_target_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approval_receipt": {
      "$ref": "#/$defs/receipt"
    },
    "protection_coverage": {
      "$ref": "#/$defs/coverage"
    },
    "preference_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrument_id",
          "ticker",
          "protected_existing_holding",
          "client_preference_locked",
          "final_target_locked_to_current",
          "current_weight",
          "preference_confirmed_at",
          "preference_source_ids",
          "unlock_confirmed_at",
          "unlock_source_ids"
        ],
        "properties": {
          "instrument_id": {
            "type": "string",
            "minLength": 1
          },
          "ticker": {
            "type": [
              "string",
              "null"
            ]
          },
          "protected_existing_holding": {
            "type": "boolean"
          },
          "client_preference_locked": {
            "type": "boolean"
          },
          "final_target_locked_to_current": {
            "type": "boolean"
          },
          "current_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "preference_confirmed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "preference_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "unlock_confirmed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "unlock_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "current_nav": {
      "type": "object"
    },
    "total_stock_ceiling": {
      "$ref": "#/$defs/ceiling"
    },
    "portfolio_caps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cap"
      }
    },
    "exposure_coverage": {
      "$ref": "#/$defs/coverage"
    },
    "exposures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exposure"
      }
    },
    "funding_buckets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/funding"
      },
      "minItems": 1
    },
    "budget_normalizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fx"
      }
    },
    "upstream_net_capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producer_contract": {
          "type": "string",
          "minLength": 1
        },
        "gross_input_digest": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      },
      "required": [
        "producer_contract",
        "gross_input_digest",
        "amount",
        "receipt"
      ]
    }
  },
  "required": [
    "schema_version",
    "profile",
    "approval_contract_sha256",
    "identity",
    "family_owner",
    "account_owners",
    "budget_currency",
    "source_db_sha256",
    "target_version",
    "approved_long_term_target",
    "approved_target_digest",
    "approval_receipt",
    "protection_coverage",
    "preference_locks",
    "current_nav",
    "total_stock_ceiling",
    "portfolio_caps",
    "exposure_coverage",
    "exposures",
    "funding_buckets"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:livingwater:c7:family-long-term-input:v1",
