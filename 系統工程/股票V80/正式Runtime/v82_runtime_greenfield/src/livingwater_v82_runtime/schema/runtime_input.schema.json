{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livingwaterai.local/schemas/A78_W02_V82_Runtime_Input.schema.json",
  "title": "LivingWaterAI V82 Runtime Input Contract — W2 Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "run_id",
    "client_project_version",
    "asset",
    "execution_account",
    "client_target",
    "upstream_v70_snapshot",
    "c7_funding_context",
    "confirmed_position_snapshot",
    "source_lineage"
  ],
  "properties": {
    "contract_name": {
      "const": "LivingWaterAI.V82.RuntimeInput"
    },
    "contract_version": {
      "const": "V82-INPUT-v1.0.1-W2-RECHECK2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "client_project_version": {
      "type": "string",
      "minLength": 1
    },
    "asset": {
      "$ref": "#/$defs/AssetIdentity"
    },
    "execution_account": {
      "$ref": "#/$defs/ExecutionAccountRef"
    },
    "client_target": {
      "$ref": "#/$defs/ClientTarget"
    },
    "upstream_v70_snapshot": {
      "$ref": "#/$defs/UpstreamV70Snapshot"
    },
    "c7_funding_context": {
      "$ref": "#/$defs/C7FundingContext"
    },
    "confirmed_position_snapshot": {
      "type": [
        "object",
        "string"
      ],
      "description": "Broker/confirmed-source position fact or immutable reference; detailed position arithmetic is W3/W8 scope."
    },
    "market_data_bundle": {
      "type": [
        "object",
        "null"
      ],
      "description": "Provider facts and metadata. W2 does not define calculations."
    },
    "event_context": {
      "type": [
        "object",
        "null"
      ],
      "description": "Event/assertion/coverage facts consumed by V82-D07; generic quality remains V82-B03."
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "AssetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_type",
        "asset_grade",
        "portfolio_role"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_type": {
          "enum": [
            "INDIVIDUAL_STOCK",
            "BROAD_ETF",
            "SECTOR_ETF",
            "INDUSTRY_ETF",
            "THEME_ETF",
            "HIGH_VOLATILITY_ETF",
            "OTHER_APPROVED_EQUITY_VEHICLE"
          ]
        },
        "asset_grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "portfolio_role": {
          "enum": [
            "CORE",
            "SATELLITE",
            "UNKNOWN"
          ]
        }
      }
    },
    "ExecutionAccountRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "broker",
        "account"
      ],
      "properties": {
        "domain": {
          "enum": [
            "TW_LOCAL_BROKER",
            "TW_SUB_BROKERAGE",
            "US_BROKER"
          ]
        },
        "broker": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ClientTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_target_position",
        "authorization_reference"
      ],
      "properties": {
        "project_target_position": {},
        "position_cap": {},
        "authorization_reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Authorized client target/constraints. C/Mentor provides/orchestrates; V82 consumes and does not rewrite authorization."
    },
    "UpstreamV70Snapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "run_id",
        "upstream_v70_snapshot_id",
        "v70_stock_tactical_budget_amount",
        "v70_stock_tactical_budget_currency",
        "v70_stock_tactical_budget_status",
        "v70_stock_tactical_budget_data_as_of",
        "v70_original_dry_powder_amount",
        "v70_original_dry_powder_currency",
        "v70_budget_source_reference",
        "v70_budget_data_quality",
        "v70_budget_issue_codes"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "upstream_v70_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "v70_stock_tactical_budget_amount": {
          "type": [
            "number",
            "string"
          ],
          "description": "V70-owned amount. UNKNOWN representation may be passed as a sentinel string; executable UNKNOWN semantics are W3."
        },
        "v70_stock_tactical_budget_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "v70_stock_tactical_budget_status": {},
        "v70_stock_tactical_budget_data_as_of": {
          "type": "string",
          "minLength": 1
        },
        "v70_original_dry_powder_amount": {},
        "v70_original_dry_powder_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "v70_budget_source_reference": {},
        "v70_budget_data_quality": {
          "enum": [
            "OK",
            "FALLBACK_USED",
            "INSUFFICIENT",
            "UNKNOWN"
          ]
        },
        "v70_budget_issue_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "description": "Exact Engineering 63-A minimum V70→V82 Tactical Budget Envelope. V82 consumes this upstream context but does not recompute V70 strategic/tactical budget. v70_original_dry_powder_* is upstream context only and is NOT V82 executable funding; execution funding is exclusively the same-account C7 equity executable leg."
    },
    "CashState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "available",
        "unsettled",
        "reserved"
      ],
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0
        },
        "available": {
          "type": "number",
          "minimum": 0
        },
        "unsettled": {
          "type": "number",
          "minimum": 0
        },
        "reserved": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ExecutableLeg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "cash_basis",
        "source_domain",
        "source_broker",
        "source_account"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "cash_basis": {
          "const": "AVAILABLE"
        },
        "source_domain": {
          "type": "string",
          "enum": [
            "TW_LOCAL_BROKER",
            "TW_SUB_BROKERAGE",
            "US_BROKER"
          ]
        },
        "source_broker": {
          "type": "string",
          "minLength": 1
        },
        "source_account": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ExecutableBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equity",
        "bond"
      ],
      "properties": {
        "equity": {
          "$ref": "#/$defs/ExecutableLeg"
        },
        "bond": {
          "$ref": "#/$defs/ExecutableLeg"
        }
      }
    },
    "AccountContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "broker",
        "account",
        "bucket_new_investment_amount",
        "brokerage_cash_state",
        "executable_budget",
        "source_reference_ids"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "TW_LOCAL_BROKER",
            "TW_SUB_BROKERAGE",
            "US_BROKER"
          ]
        },
        "broker": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "bucket_new_investment_amount": {
          "type": "number",
          "minimum": 0
        },
        "brokerage_cash_state": {
          "$ref": "#/$defs/CashState"
        },
        "executable_budget": {
          "$ref": "#/$defs/ExecutableBudget"
        },
        "source_reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "C7FundingContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_name",
        "contract_version",
        "run_id",
        "base_currency",
        "bank_cash_scope",
        "total_new_investment_amount",
        "contexts",
        "source_reference_ids"
      ],
      "properties": {
        "contract_name": {
          "const": "LivingWaterAI.C.Work7.FundingContext"
        },
        "contract_version": {
          "const": "C-W7-FUND-v1.0.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "base_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "bank_cash_scope": {
          "const": "OUT_OF_SCOPE"
        },
        "total_new_investment_amount": {
          "type": "number",
          "minimum": 0
        },
        "contexts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/AccountContext"
          }
        },
        "source_reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "description": "Verbatim structural consumer contract for C-W7-FUND-v1.0.0. Required semantic validation is frozen in x-semantic-invariants and A78_W02_Account_Isolation_Contract.json; W6 later implements it defensively."
    }
  },
  "x-semantic-invariants": [
    "run_id == upstream_v70_snapshot.run_id == c7_funding_context.run_id",
    "execution_account must match exactly one C7 context by domain+broker+account",
    "selected executable_budget.equity owner fields must equal the selected context identity",
    "selected executable_budget.equity.cash_basis == AVAILABLE",
    "C7 contexts contain exactly one TW_LOCAL_BROKER, one TW_SUB_BROKERAGE, and one US_BROKER",
    "broker+account pair is unique across C7 contexts",
    "each available/unsettled/reserved cash substate is finite nonnegative and individually <= total",
    "for each account equity.amount + bond.amount <= brokerage_cash_state.available",
    "for each account equity.amount + bond.amount <= bucket_new_investment_amount",
    "sum(context.bucket_new_investment_amount) == total_new_investment_amount within upstream reconciliation tolerance",
    "Bound Equity Budget View amount is executable_budget.equity.amount and currency is c7_funding_context.base_currency",
    "V82 never derives available as total-unsettled-reserved and never consumes bond/bank/SGOV/general-idle/cross-account funding"
  ]
}
