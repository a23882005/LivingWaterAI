      ],
      "properties": {
        "support_status": {
          "enum": [
            "SUPPORTED_BY_BASELINE",
            "SUPPORTED_BY_EXPLICIT_ASSUMPTION",
            "SOURCE_INELIGIBLE",
            "UNSUPPORTED_BY_BASELINE",
