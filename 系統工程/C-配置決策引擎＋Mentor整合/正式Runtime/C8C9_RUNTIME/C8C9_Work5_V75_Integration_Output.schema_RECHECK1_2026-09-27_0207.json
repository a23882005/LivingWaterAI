{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livingwaterai.local/schemas/C8C9_Work5_V75_Integration_Output.schema.json",
  "title": "C8C9 Work5 V75 Integration Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "baseline_id",
    "run_id",
    "owner",
    "currency",
    "work3_context_handoff_id",
    "upstream_v70_snapshot_id",
    "shared_context_id",
    "shared_context_digest_sha256",
    "v75_source_context_digest_sha256",
    "consumed_bond_executable_budget",
    "sgov_semantics",
    "canonical_v75_runtime_ready_snapshot",
    "canonical_v75_output",
    "source_semantics_policy",
    "integration_diagnostics"
  ],
  "properties": {
    "contract_name": {
      "const": "LivingWaterAI.C8C9.Work5.V75IntegrationResult"
    },
    "contract_version": {
      "const": "C8C9-W5-V75AO-v1.0.1-RECHECK1"
    },
    "baseline_id": {
      "const": "C8C9-BL-20260926T1014+0800-W1-5a1038869805a25e"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "funding_domain",
        "broker",
        "account"
      ],
      "properties": {
        "funding_domain": {
          "enum": [
            "TW_LOCAL_BROKER",
            "TW_SUB_BROKERAGE",
            "US_BROKER"
          ]
        },
        "broker": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "work3_context_handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "upstream_v70_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "shared_context_id": {
      "type": "string",
      "minLength": 1
    },
    "shared_context_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "v75_source_context_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "consumed_bond_executable_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "cash_basis",
        "owner",
        "source_pointer"
      ],
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "cash_basis": {
          "const": "AVAILABLE"
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "funding_domain",
            "broker",
            "account"
          ],
          "properties": {
            "funding_domain": {
              "enum": [
                "TW_LOCAL_BROKER",
                "TW_SUB_BROKERAGE",
                "US_BROKER"
              ]
            },
            "broker": {
              "type": "string",
              "minLength": 1
            },
            "account": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_pointer": {
          "const": "/funding_context/executable_budget/bond"
        }
      }
    },
    "sgov_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sgov_bond_bucket_amount",
        "sgov_dry_powder_bucket_amount",
        "v75_undeployed_to_sgov",
        "roles_kept_separate",
        "dry_powder_input_read_only",
        "adapter_created_undeployed_route",
        "same_account_usd_route_guard_enforced"
      ],
      "properties": {
        "sgov_bond_bucket_amount": {
          "$ref": "#/$defs/MoneyValue"
        },
        "sgov_dry_powder_bucket_amount": {
          "$ref": "#/$defs/MoneyValue"
        },
        "v75_undeployed_to_sgov": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "roles_kept_separate": {
          "const": true
        },
        "dry_powder_input_read_only": {
          "const": true
        },
        "adapter_created_undeployed_route": {
          "const": false
        },
        "same_account_usd_route_guard_enforced": {
          "const": true
        }
      }
    },
    "canonical_v75_runtime_ready_snapshot": {
      "additionalProperties": false,
      "description": "Cutover/readiness envelope. It never recomputes Work1-Work5 investment logic.",
      "properties": {
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "broker_account_id": {
          "minLength": 1,
          "title": "Broker Account Id",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "cutover_state": {
          "$ref": "#/$defs/Work6CutoverState"
        },
        "runtime_ready": {
          "title": "Runtime Ready",
          "type": "boolean"
        },
        "gate_state": {
          "$ref": "#/$defs/GateState"
        },
        "evaluation_state": {
          "$ref": "#/$defs/EvaluationState"
        },
        "final_classification": {
          "$ref": "#/$defs/Work5FinalClassification"
        },
        "output": {
          "$ref": "#/$defs/V75RunOutput"
        },
        "blocking_reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Reason Codes",
          "type": "array"
        },
        "source_lineage": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Lineage",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "broker_account_id",
        "currency",
        "cutover_state",
        "runtime_ready",
        "gate_state",
        "evaluation_state",
        "final_classification",
        "output",
        "blocking_reason_codes",
        "source_lineage"
      ],
      "title": "Work6RuntimeReadySnapshot",
      "type": "object"
    },
    "canonical_v75_output": {
      "$ref": "#/$defs/V75RunOutput"
    },
    "source_semantics_policy": {
      "const": "PRESERVE_FROZEN_V75_NO_BUSINESS_RECOMPUTE"
    },
    "integration_diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "BrokerDomainType": {
      "enum": [
        "TW_LOCAL_BROKER",
        "TW_SUB_BROKERAGE",
        "US_BROKER"
      ],
      "title": "BrokerDomainType",
      "type": "string"
    },
    "CanonicalUnit": {
      "enum": [
        "PERCENT",
        "PERCENTAGE_POINT",
        "BASIS_POINT"
      ],
      "title": "CanonicalUnit",
      "type": "string"
    },
    "DeploymentState": {
      "enum": [
        "HARD_WAIT",
        "PAUSE",
        "SMALL_BUY",
        "LEFT_BUY",
        "DEEP_LEFT_BUY",
        "RIGHT_COMPLETE"
      ],
      "title": "DeploymentState",
      "type": "string"
    },
    "EvaluationState": {
      "enum": [
        "COMPLETE",
        "INSUFFICIENT_DATA",
        "INVALID_INPUT",
        "REVIEW_REQUIRED"
      ],
      "title": "EvaluationState",
      "type": "string"
    },
    "ExistingPositionAction": {
      "enum": [
        "HOLD",
        "REBOUND_SMALL_SELL",
        "TECHNICAL_TRIM",
        "TRUE_RISK_REDUCTION",
        "NOT_APPLICABLE"
      ],
      "title": "ExistingPositionAction",
      "type": "string"
    },
    "GateState": {
      "enum": [
        "PASS",
        "RESTRICT",
        "HARD_WAIT",
        "INSUFFICIENT_DATA",
        "NOT_APPLICABLE"
      ],
      "title": "GateState",
      "type": "string"
    },
    "JsonValue": {},
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "MoneyValue": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/ValueStatus"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "MoneyValue",
      "type": "object"
    },
    "NewMoneyAction": {
      "enum": [
        "PAUSE",
        "WAIT",
        "SMALL_BUY",
        "LEFT_BUY",
        "DEEP_LEFT_BUY",
        "RIGHT_COMPLETE",
        "NOT_APPLICABLE"
      ],
      "title": "NewMoneyAction",
      "type": "string"
    },
    "PerAssetDecision": {
      "additionalProperties": false,
      "description": "Schema only. Work2 never creates a decision or calculates amounts.",
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "deployment_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeploymentState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deployment_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deploy_amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "new_money_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/NewMoneyAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "existing_position_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExistingPositionAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "existing_reduction_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "classification": {
          "items": {
            "type": "string"
          },
          "title": "Classification",
          "type": "array"
        },
        "gate_state": {
          "$ref": "#/$defs/GateState"
        },
        "evaluation_state": {
          "$ref": "#/$defs/EvaluationState"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "source_lineage": {
          "items": {
            "type": "string"
          },
          "title": "Source Lineage",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "gate_state",
        "evaluation_state"
      ],
      "title": "PerAssetDecision",
      "type": "object"
    },
    "PercentValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "$ref": "#/$defs/CanonicalUnit",
          "default": "PERCENT"
        }
      },
      "required": [
        "value"
      ],
      "title": "PercentValue",
      "type": "object"
    },
    "V75RunOutput": {
      "additionalProperties": false,
      "description": "Output schema skeleton only. No Work2 engine populates investment decisions.",
      "properties": {
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "predicate_version": {
          "title": "Predicate Version",
          "type": "string"
        },
        "deployment_parameter_version": {
          "minLength": 1,
          "title": "Deployment Parameter Version",
          "type": "string"
        },
        "broker_account_id": {
          "minLength": 1,
          "title": "Broker Account Id",
          "type": "string"
        },
        "broker_domain_type": {
          "$ref": "#/$defs/BrokerDomainType"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "bond_long_term_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bond_allocation_final": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Bond Allocation Final",
          "type": "object"
        },
        "per_asset_decisions": {
          "items": {
            "$ref": "#/$defs/PerAssetDecision"
          },
          "title": "Per Asset Decisions",
          "type": "array"
        },
        "sgov_bond_bucket_amount": {
          "$ref": "#/$defs/MoneyValue"
        },
        "v75_undeployed_to_sgov": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "formal_output_eligible": {
          "title": "Formal Output Eligible",
          "type": "boolean"
        },
        "evaluation_state": {
          "$ref": "#/$defs/EvaluationState"
        },
        "missing_required_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Required Fields",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "source_lineage": {
          "items": {
            "type": "string"
          },
          "title": "Source Lineage",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "rule_version",
        "predicate_version",
        "deployment_parameter_version",
        "broker_account_id",
        "broker_domain_type",
        "currency",
        "sgov_bond_bucket_amount",
        "formal_output_eligible",
        "evaluation_state"
      ],
      "title": "V75RunOutput",
      "type": "object"
    },
    "ValueStatus": {
      "enum": [
        "KNOWN",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "ValueStatus",
      "type": "string"
    },
    "Work5FinalClassification": {
      "enum": [
        "ACTIONABLE",
        "NO_NEW_MONEY_ACTION",
        "EXISTING_POSITION_REVIEW",
        "HARD_WAIT",
        "INSUFFICIENT_DATA",
        "INVALID_INPUT",
        "REVIEW_REQUIRED"
      ],
      "title": "Work5FinalClassification",
      "type": "string"
    },
    "Work6CutoverState": {
      "enum": [
        "READY",
        "BLOCKED"
      ],
      "title": "Work6CutoverState",
      "type": "string"
    }
  }
}
