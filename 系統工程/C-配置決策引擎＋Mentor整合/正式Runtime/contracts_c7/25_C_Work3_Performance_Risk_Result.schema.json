{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:livingwaterai:c-work3:performance-risk-result:v1.0.1",
  "title": "C Work3 Performance Risk ModuleResult v1.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_name",
    "status",
    "formal_output_eligibility",
    "payload",
    "issues",
    "traceability"
  ],
  "properties": {
    "module_name": {
      "const": "C_WORK3_PERFORMANCE_RISK"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ]
    },
    "formal_output_eligibility": {
      "$ref": "#/$defs/formalGate"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/payload"
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trace"
      }
    }
  },
  "$defs": {
    "formalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "scope",
        "blocking_reasons",
        "warning_reasons",
        "evaluated_at",
        "rule_references"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ]
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "warning_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evaluated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eligible": {
                "const": false
              }
            },
            "required": [
              "eligible"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eligible": {
                "const": true
              }
            },
            "required": [
              "eligible"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "enum": [
                  "FULL",
                  "PARTIAL"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "FULL"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "blocking_reasons": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "field_path",
        "message",
        "owner",
        "blocking",
        "source_reference_ids"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "BLOCKING"
          ]
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "const": "C_INTEGRATION"
        },
        "blocking": {
          "type": "boolean"
        },
        "source_reference_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "severity": {
                "const": "BLOCKING"
              }
            },
            "required": [
              "severity"
            ]
          },
          "then": {
            "properties": {
              "blocking": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_path",
        "owner",
        "rule_references",
        "source_reference_ids",
        "as_of",
        "data_quality",
        "issue_codes"
      ],
      "properties": {
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "const": "C_INTEGRATION"
        },
        "rule_references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source_reference_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_quality": {
          "enum": [
            "OK",
            "FALLBACK_USED",
            "INSUFFICIENT",
            "UNKNOWN"
          ]
        },
        "issue_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxy_ticker",
        "usage",
        "authorization",
        "source_native_status"
      ],
      "properties": {
        "proxy_ticker": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "enum": [
            "NOT_USED",
            "USED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "authorization": {
          "enum": [
            "AUTHORIZED",
            "UNAUTHORIZED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "source_native_status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "usage": {
                "const": "USED"
              }
            },
            "required": [
              "usage"
            ]
          },
          "then": {
            "properties": {
              "proxy_ticker": {
                "type": "string",
                "minLength": 1
              },
              "authorization": {
                "const": "AUTHORIZED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "usage": {
                "enum": [
                  "NOT_USED",
                  "NOT_APPLICABLE"
                ]
              }
            },
            "required": [
              "usage"
            ]
          },
          "then": {
            "properties": {
              "proxy_ticker": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
