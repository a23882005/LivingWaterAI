{
  "$defs": {
    "CanonicalUnit": {
      "enum": [
        "PERCENT",
        "PERCENTAGE_POINT",
        "BASIS_POINT"
      ],
      "title": "CanonicalUnit",
      "type": "string"
    },
    "DeploymentState": {
      "enum": [
        "HARD_WAIT",
        "PAUSE",
        "SMALL_BUY",
        "LEFT_BUY",
        "DEEP_LEFT_BUY",
        "RIGHT_COMPLETE"
      ],
      "title": "DeploymentState",
      "type": "string"
    },
    "EvaluationState": {
      "enum": [
        "COMPLETE",
        "INSUFFICIENT_DATA",
        "INVALID_INPUT",
        "REVIEW_REQUIRED"
      ],
      "title": "EvaluationState",
      "type": "string"
    },
    "ExistingPositionAction": {
      "enum": [
        "HOLD",
        "REBOUND_SMALL_SELL",
        "TECHNICAL_TRIM",
        "TRUE_RISK_REDUCTION",
        "NOT_APPLICABLE"
      ],
      "title": "ExistingPositionAction",
      "type": "string"
    },
    "GateState": {
      "enum": [
        "PASS",
        "RESTRICT",
        "HARD_WAIT",
        "INSUFFICIENT_DATA",
        "NOT_APPLICABLE"
      ],
      "title": "GateState",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "NewMoneyAction": {
      "enum": [
        "PAUSE",
        "WAIT",
        "SMALL_BUY",
        "LEFT_BUY",
        "DEEP_LEFT_BUY",
        "RIGHT_COMPLETE",
        "NOT_APPLICABLE"
      ],
      "title": "NewMoneyAction",
      "type": "string"
    },
    "PercentValue": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/CanonicalUnit",
          "default": "PERCENT"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "PercentValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema only. Work2 never creates a decision or calculates amounts.",
  "properties": {
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "classification": {
      "items": {
        "type": "string"
      },
      "title": "Classification",
      "type": "array"
    },
    "deploy_amount": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deployment_pct": {
      "anyOf": [
        {
          "$ref": "#/$defs/PercentValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deployment_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeploymentState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evaluation_state": {
      "$ref": "#/$defs/EvaluationState"
    },
    "existing_position_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingPositionAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "existing_reduction_pct": {
      "anyOf": [
        {
          "$ref": "#/$defs/PercentValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gate_state": {
      "$ref": "#/$defs/GateState"
    },
    "new_money_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/NewMoneyAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "source_lineage": {
      "items": {
        "type": "string"
      },
      "title": "Source Lineage",
      "type": "array"
    }
  },
  "required": [
    "asset_id",
    "gate_state",
    "evaluation_state"
  ],
  "title": "PerAssetDecision",
  "type": "object"
}
