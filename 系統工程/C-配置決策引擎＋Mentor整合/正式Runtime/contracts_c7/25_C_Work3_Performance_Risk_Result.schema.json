        },
        "sortino": {
          "$ref": "#/$defs/windowMetricMap"
        },
        "calmar": {
          "$ref": "#/$defs/windowMetricMap"
        }
      }
    },
    "moneyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_state",
        "amount",
        "currency",
        "as_of",
        "data_quality",
        "freshness",
        "issue_codes",
        "source_reference_ids"
      ],
      "properties": {
        "value_state": {
          "enum": [
            "KNOWN",
            "NONE",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_quality": {
          "enum": [
            "OK",
            "FALLBACK_USED",
            "INSUFFICIENT",
            "UNKNOWN"
          ]
