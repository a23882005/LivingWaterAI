      "properties": {
        "value_state": {
          "type": "string",
          "enum": [
            "KNOWN",
            "NONE",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_quality": {
          "type": "string",
