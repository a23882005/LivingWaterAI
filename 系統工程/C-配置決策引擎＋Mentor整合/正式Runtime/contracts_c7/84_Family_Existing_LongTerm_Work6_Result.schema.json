      "allOf": [
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "KNOWN"
              }
            },
            "required": [
              "value_state"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "type": "number"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          }
        },
        {
