{
  "$defs": {
    "BrokerDomainType": {
      "enum": [
        "TW_LOCAL_BROKER",
        "TW_SUB_BROKERAGE",
        "US_BROKER"
      ],
      "title": "BrokerDomainType",
      "type": "string"
    },
    "CanonicalUnit": {
      "enum": [
        "PERCENT",
        "PERCENTAGE_POINT",
        "BASIS_POINT"
      ],
      "title": "CanonicalUnit",
      "type": "string"
    },
    "FreshnessState": {
      "enum": [
        "FRESH",
        "STALE",
        "SUPERSEDED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "FreshnessState",
      "type": "string"
    },
    "HoldingSnapshot": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "broker_account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Broker Account Id"
        }
      },
      "required": [
        "asset_id",
        "amount"
      ],
      "title": "HoldingSnapshot",
      "type": "object"
    },
    "JsonValue": {},
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "MoneyValue": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/ValueStatus"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "MoneyValue",
      "type": "object"
    },
    "PerAssetDeploymentInput": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "broker_account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Broker Account Id"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "eligibility_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eligibility State"
        },
        "existing_position_amount": {
          "$ref": "#/$defs/Money"
        },
        "remaining_target_gap_amount": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "asset_id",
        "remaining_target_gap_amount",
        "existing_position_amount",
        "currency"
      ],
      "title": "PerAssetDeploymentInput",
      "type": "object"
    },
    "PerAssetPredicateEvidence": {
      "additionalProperties": false,
      "description": "Asset-scoping envelope only; it does not calculate or aggregate predicates.",
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "predicate_results": {
          "items": {
            "$ref": "#/$defs/PredicateResult"
          },
          "title": "Predicate Results",
          "type": "array"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "PerAssetPredicateEvidence",
      "type": "object"
    },
    "PercentValue": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/CanonicalUnit",
          "default": "PERCENT"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "PercentValue",
      "type": "object"
    },
    "PredicateAssessmentStatus": {
      "enum": [
        "VALID",
        "INSUFFICIENT_DATA",
        "INVALID_INPUT",
        "REVIEW_REQUIRED",
        "NOT_APPLICABLE"
      ],
      "title": "PredicateAssessmentStatus",
      "type": "string"
    },
    "PredicateResult": {
      "additionalProperties": false,
      "properties": {
        "aggregate_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregate State"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            }
          ],
          "title": "As Of"
        },
        "assessment_status": {
          "$ref": "#/$defs/PredicateAssessmentStatus"
        },
        "input_freshness_state": {
          "$ref": "#/$defs/FreshnessState"
        },
        "predicate_id": {
          "title": "Predicate Id",
          "type": "string"
        },
        "predicate_version": {
          "title": "Predicate Version",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "required_input_missing": {
          "items": {
            "type": "string"
          },
          "title": "Required Input Missing",
          "type": "array"
        },
        "source_lineage": {
          "items": {
            "type": "string"
          },
          "title": "Source Lineage",
          "type": "array"
        },
        "sub_states": {
          "items": {
            "type": "string"
          },
          "title": "Sub States",
          "type": "array"
        }
      },
      "required": [
        "predicate_id",
        "predicate_version",
        "assessment_status",
        "as_of",
        "source_lineage",
        "input_freshness_state"
      ],
      "title": "PredicateResult",
      "type": "object"
    },
    "SettlementState": {
      "enum": [
        "SETTLED",
        "UNSETTLED",
        "PARTIAL",
        "UNKNOWN"
      ],
      "title": "SettlementState",
      "type": "string"
    },
    "SnapshotModel": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "minLength": 1,
          "title": "Data Source",
          "type": "string"
        },
        "data_timestamp": {
          "format": "date-time",
          "title": "Data Timestamp",
          "type": "string"
        },
        "freshness_state": {
          "$ref": "#/$defs/FreshnessState"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "source_lineage": {
          "items": {
            "type": "string"
          },
          "title": "Source Lineage",
          "type": "array"
        }
      },
      "required": [
        "data_timestamp",
        "data_source",
        "freshness_state"
      ],
      "title": "SnapshotModel",
      "type": "object"
    },
    "TargetHoldingSnapshot": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "broker_account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Broker Account Id"
        },
        "target_amount": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "asset_id",
        "target_amount"
      ],
      "title": "TargetHoldingSnapshot",
      "type": "object"
    },
    "ValueStatus": {
      "enum": [
        "KNOWN",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "ValueStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_timestamp": {
      "format": "date-time",
      "title": "Analysis Timestamp",
      "type": "string"
    },
    "authorized_universe": {
      "items": {
        "type": "string"
      },
      "title": "Authorized Universe",
      "type": "array"
    },
    "bond_executable_budget": {
      "$ref": "#/$defs/Money"
    },
    "broker_account_id": {
      "minLength": 1,
      "title": "Broker Account Id",
      "type": "string"
    },
    "broker_cash_available": {
      "$ref": "#/$defs/MoneyValue"
    },
    "broker_cash_reserved": {
      "$ref": "#/$defs/MoneyValue"
    },
    "broker_cash_total": {
      "$ref": "#/$defs/MoneyValue"
    },
    "broker_cash_unsettled": {
      "$ref": "#/$defs/MoneyValue"
    },
    "broker_domain_type": {
      "$ref": "#/$defs/BrokerDomainType"
    },
    "client_ref": {
      "minLength": 1,
      "title": "Client Ref",
      "type": "string"
    },
    "currency": {
      "title": "Currency",
      "type": "string"
    },
    "deployment_parameter_version": {
      "minLength": 1,
      "title": "Deployment Parameter Version",
      "type": "string"
    },
    "existing_bond_holdings": {
      "items": {
        "$ref": "#/$defs/HoldingSnapshot"
      },
      "title": "Existing Bond Holdings",
      "type": "array"
    },
    "expected_rule_version": {
      "minLength": 1,
      "title": "Expected Rule Version",
      "type": "string"
    },
    "funding_settlement_status": {
      "$ref": "#/$defs/SettlementState"
    },
    "life_stage_code": {
      "minLength": 1,
      "title": "Life Stage Code",
      "type": "string"
    },
    "market_snapshot": {
      "$ref": "#/$defs/SnapshotModel"
    },
    "per_asset_inputs": {
      "items": {
        "$ref": "#/$defs/PerAssetDeploymentInput"
      },
      "title": "Per Asset Inputs",
      "type": "array"
    },
    "per_asset_predicate_evidence": {
      "items": {
        "$ref": "#/$defs/PerAssetPredicateEvidence"
      },
      "title": "Per Asset Predicate Evidence",
      "type": "array"
    },
    "predicate_results": {
      "items": {
        "$ref": "#/$defs/PredicateResult"
      },
      "title": "Predicate Results",
      "type": "array"
    },
    "predicate_version": {
      "title": "Predicate Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "sgov_bond_bucket_amount": {
      "$ref": "#/$defs/MoneyValue"
    },
    "sgov_dry_powder_bucket_amount": {
      "$ref": "#/$defs/MoneyValue"
    },
    "source_lineage": {
      "items": {
        "type": "string"
      },
      "title": "Source Lineage",
      "type": "array"
    },
    "strategic_bond_weight_b0": {
      "anyOf": [
        {
          "$ref": "#/$defs/PercentValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_bond_holdings": {
      "items": {
        "$ref": "#/$defs/TargetHoldingSnapshot"
      },
      "title": "Target Bond Holdings",
      "type": "array"
    },
    "v70_snapshot": {
      "$ref": "#/$defs/SnapshotModel"
    }
  },
  "required": [
    "client_ref",
    "run_id",
    "analysis_timestamp",
    "expected_rule_version",
    "predicate_version",
    "deployment_parameter_version",
    "broker_account_id",
    "broker_domain_type",
    "currency",
    "bond_executable_budget",
    "broker_cash_total",
    "broker_cash_available",
    "broker_cash_unsettled",
    "broker_cash_reserved",
    "sgov_bond_bucket_amount",
    "sgov_dry_powder_bucket_amount",
    "funding_settlement_status",
    "life_stage_code",
    "strategic_bond_weight_b0",
    "existing_bond_holdings",
    "target_bond_holdings",
    "authorized_universe",
    "market_snapshot",
    "v70_snapshot",
    "source_lineage"
  ],
  "title": "V75RunInput",
  "type": "object"
}
